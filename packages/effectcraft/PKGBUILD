pkgrel=1
pkgdesc="EffectCraft - Open-source motion graphics and visual effects compositor"
arch=('x86_64')
url="https://github.com/storytold/effectcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/effectcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('2ca284b77910ec66ecd1adf0ecc32ea83436f93719162dc0b566ad8765c6688c')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
