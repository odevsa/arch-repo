pkgdesc="EffectCraft - Open-source motion graphics and visual effects compositor"
arch=('x86_64')
url="https://github.com/storytold/effectcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

