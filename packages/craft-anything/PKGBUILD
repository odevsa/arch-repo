pkgdesc="Craft Anything - Open-source engine to inspect software and craft your own"
arch=('x86_64')
url="https://github.com/storytold/craft-anything"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/craft-anything/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('310aed21a960aabc30274de69a992ec5e89675d540d38a355a9bc6ccddf36cb6')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}

