pkgname=pi
pkgver=1.5.2
pkgrel=1
pkgdesc="AI agent toolkit: unified LLM API, agent loop, TUI, coding agent CLI"
arch=('x86_64')
url="https://github.com/earendil-works/pi"
license=('MIT')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/earendil-works/pi/releases/download/v${pkgver}/pi-linux-x64.tar.gz")
sha256sums=('811c6f2c9e7aaee252b5404252e556fb713aa209c1f7f924226aa77d4ef70cb5')

package() {
  install -d "${pkgdir}/usr/lib/${pkgname}"
  install -d "${pkgdir}/usr/bin"

  cp -dr --no-preserve=ownership "${srcdir}/${pkgname}/." "${pkgdir}/usr/lib/${pkgname}/"
  chmod 755 "${pkgdir}/usr/lib/${pkgname}/${pkgname}"

  ln -s "/usr/lib/${pkgname}/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
}
