pkgdesc="FilmCraft - Open-source, clean-room reimplementation of Adobe Premiere Pro"
arch=('x86_64')
url="https://github.com/storytold/filmcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/filmcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('8ff475b33989d4a759ecb974ecc82792b01d3a380a4dd3a3cc2342c61ad5d49b')

package() {
