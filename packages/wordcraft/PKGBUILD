pkgname=wordcraft
pkgver=0.14.0
pkgrel=1
pkgdesc="WordCraft - Open-source, clean-room reimplementation of Microsoft Word"
arch=('x86_64')
url="https://github.com/storytold/wordcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/wordcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('0e8f4ce3fc4662d71631125b9e02ae854658ef608c85ea6e304c9dc60e239641')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
