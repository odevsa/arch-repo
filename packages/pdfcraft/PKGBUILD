pkgname=pdfcraft
pkgver=0.10.1
pkgrel=1
pkgdesc="PdfCraft - Open-source, clean-room reimplementation of Adobe Acrobat"
arch=('x86_64')
url="https://github.com/storytold/pdfcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/pdfcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('83ed73795bcc94db71be4c61cfb4b486571b43babd0e29f9cd6b96a58bea22ab')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
