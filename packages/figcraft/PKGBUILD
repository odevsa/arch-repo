pkgname=figcraft
pkgver=0.7.0
pkgrel=1
pkgdesc="FigCraft - Open-source interface design and prototyping app"
arch=('x86_64')
url="https://github.com/storytold/figcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/figcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('7f37ec1cdb3377724b79a68351dc10301e98cb75dfb504e61995115bccbfa330')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
