pkgrel=1
pkgdesc="FigCraft - Open-source interface design and prototyping app"
arch=('x86_64')
url="https://github.com/storytold/figcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/figcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('dd376f5d71cc3d97e64a4dbc04aa568b98ea0115548cf768d65672e44691ae45')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
