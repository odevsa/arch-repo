pkgrel=1
pkgdesc="GridCraft - Open-source, clean-room spreadsheet app (Microsoft Excel-style)"
arch=('x86_64')
url="https://github.com/storytold/gridcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/gridcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('1bb558df8890821e061e999af69d2ba9b321c07d32901ab6819a4b428ad9a47d')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
