pkgname=vectorcraft
pkgver=0.12.0
pkgrel=1
pkgdesc="VectorCraft - Open-source, native vector illustration app"
arch=('x86_64')
url="https://github.com/storytold/vectorcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/vectorcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('722863321dfce39d7a63d032427817e2046dc5507f8743d4082fa30b023ccfcd')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
