pkgname=notecraft
pkgver=0.0.21
pkgrel=1
pkgdesc="NoteCraft - Open-source, clean-room reimplementation of Microsoft OneNote"
arch=('x86_64')
url="https://github.com/AlienTechSoftware/notecraft"
license=('Apache-2.0' 'MIT')
provides=("${pkgname}" "notcraft")
conflicts=("${pkgname}" "notcraft")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/AlienTechSoftware/notecraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('010ad6a4216303b4d6b577faf99df9ec996a032faced27eef210c51dffe53230')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
