pkgname=rtk
pkgver=0.44.0
pkgrel=1
pkgdesc="RTK - High-performance CLI proxy that cuts up to 90% of the bash output your agent reads"
arch=('x86_64')
url="https://www.rtk-ai.app"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.tar.gz::https://github.com/rtk-ai/rtk/releases/download/v${pkgver}/rtk-x86_64-unknown-linux-musl.tar.gz")
sha256sums=('3c3316cfc068e372432b415faeab73d46f8047750d488dd94d01d8d9f016a2a1')

package() {
  install -Dm755 rtk -t "${pkgdir}/usr/bin/"
}
