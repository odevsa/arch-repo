pkgname=antigravity-cli
pkgver=1.5.18
pkgrel=1
pkgbuild=6386224290725888
pkgdesc="Antigravity CLI - Command-line interface for Google Antigravity"
arch=('x86_64')
url="https://antigravity.google/"
license=('LicenseRef-Google-Antigravity')
provides=("${pkgname}" 'agy')
conflicts=("${pkgname}" 'agy')
options=(!strip !debug)

source=("${pkgname}-${pkgver}.tar.gz::https://storage.googleapis.com/antigravity-public/antigravity-cli/${pkgver}-${pkgbuild}/linux-x64/cli_linux_x64.tar.gz")
sha256sums=('a4960723ed9cf5b5ac72ed541db8df4d62741795261eb93a4681006ccb23d5ad')

package() {
    install -Dm755 "${srcdir}/antigravity" "${pkgdir}/usr/bin/agy"
}
