pkgname=sd-cpp
pkgver=956
pkgrel=1
pkgbuild=1b0ba10
pkgdesc="Stable Diffusion C/C++ - Inference of Stable Diffusion and Flux in pure C/C++ (Vulkan enabled)"
arch=('x86_64')
url="https://github.com/leejet/stable-diffusion.cpp"
license=('MIT')
depends=('glibc' 'gcc-libs' 'vulkan-icd-loader')
optdepends=('vulkan-driver: Vulkan acceleration support')
provides=("${pkgname}" "sd-cli" "sd-server")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.zip::https://github.com/leejet/stable-diffusion.cpp/releases/download/master-${pkgver}-${pkgbuild}/sd-master-${pkgbuild}-bin-Linux-Ubuntu-24.04-x86_64-vulkan.zip")
sha256sums=('cecacb8054b4fab56912ee7e109a5f48311cf7a8660c6b311ac3a6eb1156ef73')

package() {
  install -d "${pkgdir}/usr/lib/${pkgname}"
  install -d "${pkgdir}/usr/bin"

  install -m755 sd-cli "${pkgdir}/usr/lib/${pkgname}/sd-cli"
  install -m755 sd-server "${pkgdir}/usr/lib/${pkgname}/sd-server"

  cp -a *.so* "${pkgdir}/usr/lib/${pkgname}/"

  ln -s "/usr/lib/${pkgname}/sd-cli" "${pkgdir}/usr/bin/sd-cli"
  ln -s "/usr/lib/${pkgname}/sd-server" "${pkgdir}/usr/bin/sd-server"
  ln -s "/usr/lib/${pkgname}/sd-cli" "${pkgdir}/usr/bin/sd-cpp"
}
