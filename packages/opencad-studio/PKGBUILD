pkgname=opencad-studio
pkgver=2026.37
pkgrel=1
pkgdesc="OpenCADStudio - 2D/3D CAD application for DWG and DXF drawings"
arch=('x86_64')
url="https://github.com/HakanSeven12/OpenCADStudio"
license=('GPL-3.0-or-later')
depends=('fontconfig' 'libxkbcommon' 'gcc-libs' 'glibc')
optdepends=(
  'wayland: Wayland display support'
  'libx11: X11 display support'
)
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

appimage="${pkgname}-${pkgver}.AppImage"
source=("${appimage}::https://github.com/HakanSeven12/OpenCADStudio/releases/download/v${pkgver}/OpenCADStudio-v${pkgver}-linux-x86_64.AppImage")
sha256sums=('ffd0916eb7d732f81ec09e72539fffbf3c8658e38eeef12143540dc18161948e')

prepare() {
  chmod +x "${appimage}"
  ./"${appimage}" --appimage-extract
}

package() {
  install -Dm755 squashfs-root/usr/bin/OpenCADStudio "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 squashfs-root/usr/share/applications/io.github.HakanSeven12.OpenCadStudio.desktop "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/256x256/apps/io.github.HakanSeven12.OpenCadStudio.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
  install -Dm644 squashfs-root/usr/share/metainfo/io.github.HakanSeven12.OpenCadStudio.metainfo.xml "${pkgdir}/usr/share/metainfo/${pkgname}.metainfo.xml"

  sed -i \
    -e "s|^Exec=.*|Exec=${pkgname} %F|" \
    -e "s|^Icon=.*|Icon=${pkgname}|" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"
}
