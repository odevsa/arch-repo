pkgdesc="LightCraft - Open-source, clean-room reimplementation of Adobe Lightroom"
arch=('x86_64')
url="https://github.com/storytold/lightcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/lightcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('c91ef47bec44995d99ce58e6c748af9fa6ab1ff1c11de9e290e0b8231176dad1')

package() {
