pkgname=claude
pkgver=2.1.331
pkgrel=1
pkgdesc="Claude Code - An agentic coding tool that lives in your terminal"
arch=('x86_64')
url="https://code.claude.com"
license=('LicenseRef-claude-code')
depends=('bash')
optdepends=(
    'git: allow Claude to use git'
    'github-cli: interact with GitHub'
    'glab: interact with GitLab'
    'ripgrep: enhanced file search'
    'tmux: agent team split panes'
    'bubblewrap: sandboxing'
    'socat: sandboxing'
)
provides=("${pkgname}" 'claude-code')
conflicts=("${pkgname}" 'claude-code')
options=(!strip !debug)

source=("${pkgname}-${pkgver}.bin::https://downloads.claude.ai/claude-code-releases/${pkgver}/linux-x64/claude")
sha256sums=('4c00839cf46beb2b38ec310105f2d538f7f9321fe46c636299b74bcab94626b1')

package() {
    install -Dm755 "${srcdir}/${pkgname}-${pkgver}.bin" "${pkgdir}/opt/${pkgname}/bin/claude"

    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/claude" << 'EOF'
#!/bin/sh
export DISABLE_UPDATES=1
export DISABLE_INSTALLATION_CHECKS=1
exec /opt/claude/bin/claude "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/claude"
}
