license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/soundcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('a26ed59567d290ac51c7fea270abd97b88f94a32e6583d850a6676de16e4a8ca')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
