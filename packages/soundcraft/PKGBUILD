pkgname=soundcraft
pkgver=0.7.0
pkgrel=1
pkgdesc="SoundCraft - Open-source, clean-room reimplementation of Avid Pro Tools"
arch=('x86_64')
url="https://github.com/storytold/soundcraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/soundcraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('be53aae385772b74deff397c235342081ffbbe62f6926265ac99a85f5d07c6ab')

package() {
    bsdtar -xf data.tar.* -C "${pkgdir}/"
}
