license=('none')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/odevsa/mesh/releases/download/v${pkgver}/${pkgname}_${pkgver}_amd64.deb")
sha256sums=('80d4e4f529836a1286679e435220bcab433a9b556de6b950a4db5fb0ac22925e')

package() {
