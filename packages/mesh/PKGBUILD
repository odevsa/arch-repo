pkgname=mesh
pkgver=0.2.1
pkgrel=1
pkgdesc="Mesh - A lightweight 3D Mesh Viewer"
arch=('x86_64')
url="https://github.com/odevsa/mesh"
license=('none')
install=mesh.install
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/odevsa/mesh/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('0adc5fcad297642d616363425ce2a0654c40f701539cb9dd2cf075c964b2fe6d')

package() {
  bsdtar -xf data.tar.xz -C "${pkgdir}/"

  install -d "${pkgdir}/usr/share/applications"
  
  cat <<EOF >> "${pkgdir}/usr/share/applications/mimeapps.list"
[Default Applications]
model/stl=mesh.desktop;
application/x-stl=mesh.desktop;
model/3mf=mesh.desktop;
model/obj=mesh.desktop;
model/gltf+json=mesh.desktop;
model/gltf-binary=mesh.desktop;
model/fbx=mesh.desktop;
application/x-fbx=mesh.desktop;
model/vnd.fbx=mesh.desktop;
EOF
}
