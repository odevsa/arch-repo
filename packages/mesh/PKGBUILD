pkgname=mesh
pkgver=0.1.2
pkgrel=1
pkgdesc="Mesh - A lightweight 3D Mesh Viewer"
arch=('x86_64')
url="https://github.com/odevsa/mesh"
license=('none')
install=mesh.install
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/odevsa/mesh/releases/download/v${pkgver}/${pkgname}_${pkgver}_amd64.deb")
sha256sums=('a1957683fb527c039b84220d1502b6ee6c5b496868be34fbf612807b7895d53a')

package() {
  bsdtar -xf data.tar.xz -C "${pkgdir}/"

  install -d "${pkgdir}/usr/share/applications"
  
  cat <<EOF >> "${pkgdir}/usr/share/applications/mimeapps.list"
[Default Applications]
model/stl=mesh.desktop;
application/x-stl=mesh.desktop;
model/obj=mesh.desktop;
model/gltf+json=mesh.desktop;
model/gltf-binary=mesh.desktop;
EOF
}
