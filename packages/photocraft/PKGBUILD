pkgrel=1
pkgdesc="PhotoCraft - Open-source, native image editor with familiar, professional tools"
arch=('x86_64')
url="https://github.com/storytold/photocraft"
license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/photocraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('397ba230332bf00a68b501ac897cc3d590ae04e0a61c299516c16336713b77b0')

package() {
