license=('Apache-2.0')
provides=("${pkgname}")
conflicts=("${pkgname}")
options=(!strip !debug)

source=("${pkgname}-${pkgver}.deb::https://github.com/storytold/photocraft/releases/download/v${pkgver}/${pkgname}-${pkgver}-linux-x86_64.deb")
sha256sums=('955589b84849d94e5efee8f19c9c32263723bbfe89358f9109263540f0696078')

